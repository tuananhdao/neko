{
  "version": 1.0,
  "case": {
    "mesh_file": "box.nmsh",
    "output_at_end": false,
    "output_boundary": false,
    "output_checkpoints": false,
    "constants": [
      {
        "name": "initial_density",
        "value": 1.0
      },
      {
        "name": "initial_pressure",
        "value": 1.0
      }
    ],
    "time": {
      "end_time": 0.001,
      "timestep": 0.0001,
      "variable_timestep": false
    },
    "numerics": {
      "time_order": 3,
      "polynomial_order": 3,
      "c_avisc_low": 0.5,
      "c_avisc_entropy": 1.0
    },
    "fluid": {
      "scheme": "compressible",
      "gamma": 1.4,
      "initial_condition": {
        "type": "user"
      },
      "output_control": "never"
    }
  }
}
