module test_euler_idp_limiter
contains

@test
subroutine test_zero_viscosity_bar_state()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_bar_state
  implicit none

  real(kind=rp) :: left(5), right(5), flux_difference(5), bar_state(5)

  left = [1.0_rp, 2.0_rp, 3.0_rp, 4.0_rp, 5.0_rp]
  right = [2.0_rp, 4.0_rp, 6.0_rp, 8.0_rp, 10.0_rp]
  flux_difference = 0.0_rp

  call euler_idp_bar_state(left, right, flux_difference, 0.0_rp, &
       bar_state)

  @assertEqual(0.5_rp * (left + right), bar_state)
end subroutine test_zero_viscosity_bar_state

@test
subroutine test_specific_entropy()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_specific_entropy
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: state(5), expected, actual

  state = make_state(0.8_rp, 0.3_rp, 0.6_rp, gamma)
  expected = log(0.6_rp) - gamma * log(0.8_rp)
  actual = euler_idp_specific_entropy(state, gamma)
  @assertEqual(expected, actual, tolerance=64.0_rp * epsilon(1.0_rp))
end subroutine test_specific_entropy

@test
subroutine test_high_mach_entropy_roundoff()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_entropy_is_admissible
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: state(5), entropy_lower
  logical :: admissible

  state = make_state(gamma, 800.0_rp, 1.0_rp, gamma)
  entropy_lower = -gamma * log(gamma)
  admissible = euler_idp_entropy_is_admissible(state, gamma, &
       entropy_lower, 1.0e-12_rp)
  @assertTrue(admissible)

  state(5) = state(5) - 1.0e-4_rp
  admissible = euler_idp_entropy_is_admissible(state, gamma, &
       entropy_lower, 1.0e-12_rp)
  @assertFalse(admissible)
end subroutine test_high_mach_entropy_roundoff

@test
subroutine test_local_entropy_bounds_are_edge_order_independent()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_local_entropy_bounds
  implicit none

  real(kind=rp) :: stage_entropy(4,1,1,1)
  real(kind=rp) :: forward_bounds(4,1,1,1)
  real(kind=rp) :: reverse_bounds(4,1,1,1)
  real(kind=rp) :: expected(4)
  integer :: forward_left(4,3), forward_right(4,3)
  integer :: reverse_left(4,3), reverse_right(4,3)

  stage_entropy(:,1,1,1) = [3.0_rp, 2.0_rp, 1.0_rp, 0.0_rp]
  forward_left = reshape([ &
       1, 1, 1, 1, &
       2, 1, 1, 1, &
       3, 1, 1, 1], shape(forward_left))
  forward_right = reshape([ &
       2, 1, 1, 1, &
       3, 1, 1, 1, &
       4, 1, 1, 1], shape(forward_right))
  reverse_left = forward_left(:,3:1:-1)
  reverse_right = forward_right(:,3:1:-1)
  expected = [2.0_rp, 1.0_rp, 0.0_rp, 0.0_rp]

  call euler_idp_local_entropy_bounds(stage_entropy, forward_left, &
       forward_right, forward_bounds)
  call euler_idp_local_entropy_bounds(stage_entropy, reverse_left, &
       reverse_right, reverse_bounds)

  @assertEqual(expected, forward_bounds(:,1,1,1))
  @assertEqual(expected, reverse_bounds(:,1,1,1))
  @assertEqual(forward_bounds, reverse_bounds)
end subroutine test_local_entropy_bounds_are_edge_order_independent

@test
subroutine test_density_bound_relaxation_factor()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_relax_density_bounds
  implicit none

  real(kind=rp) :: relaxed_lower, relaxed_upper

  call euler_idp_relax_density_bounds(1.0_rp, 2.0_rp, 0.05_rp, &
       2.0_rp, 0.25_rp, 1.0_rp, 2, relaxed_lower, relaxed_upper)

  @assertEqual(0.9_rp, relaxed_lower, tolerance=1.0e-6_rp)
  @assertEqual(2.1_rp, relaxed_upper, tolerance=1.0e-6_rp)
end subroutine test_density_bound_relaxation_factor

@test
subroutine test_entropy_endpoint_limit()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_limit_endpoint, &
       euler_idp_specific_entropy
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: base(5), correction(5), trial(5)
  real(kind=rp) :: limit, entropy_lower
  logical :: density_limited, energy_limited, entropy_limited

  base = make_state(1.0_rp, 0.0_rp, 1.0_rp, gamma)
  correction = make_state(1.0_rp, 0.0_rp, 0.25_rp, gamma) - base
  entropy_lower = log(0.5_rp)
  call euler_idp_limit_endpoint(base, correction, 0.5_rp, 1.5_rp, &
       entropy_lower, gamma, 1.0e-12_rp, limit, density_limited, &
       energy_limited, entropy_limited)

  @assertEqual(2.0_rp / 3.0_rp, limit, tolerance=1.0e-12_rp)
  @assertFalse(density_limited)
  @assertFalse(energy_limited)
  @assertTrue(entropy_limited)
  trial = base + limit * correction
  @assertTrue(euler_idp_specific_entropy(trial, gamma) .ge. entropy_lower - 128.0_rp * epsilon(1.0_rp))
end subroutine test_entropy_endpoint_limit

@test
subroutine test_entropy_boundary_outward_limit()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_limit_endpoint
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: base(5), correction(5), limit
  logical :: density_limited, energy_limited, entropy_limited

  base = make_state(1.0_rp, 0.0_rp, 1.0_rp, gamma)
  correction = make_state(1.0_rp, 0.0_rp, 0.5_rp, gamma) - base
  call euler_idp_limit_endpoint(base, correction, 0.5_rp, 1.5_rp, &
       0.0_rp, gamma, 1.0e-12_rp, limit, density_limited, &
       energy_limited, entropy_limited)

  @assertEqual(0.0_rp, limit, tolerance=256.0_rp * epsilon(1.0_rp))
  @assertTrue(entropy_limited)
end subroutine test_entropy_boundary_outward_limit

@test
subroutine test_newton_secant_matches_bisection()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_entropy_is_admissible, &
       euler_idp_limit_endpoint
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: base(5), target(5), correction(5), trial(5)
  real(kind=rp) :: limit, lower, upper, midpoint, entropy_lower
  logical :: density_limited, energy_limited, entropy_limited, admissible
  integer :: iteration

  base = make_state(1.0_rp, 0.3_rp, 1.0_rp, gamma)
  target = make_state(1.4_rp, 1.2_rp, 0.05_rp, gamma)
  correction = target - base
  entropy_lower = log(0.4_rp)
  call euler_idp_limit_endpoint(base, correction, 0.5_rp, 2.0_rp, &
       entropy_lower, gamma, 1.0e-12_rp, limit, density_limited, &
       energy_limited, entropy_limited)

  lower = 0.0_rp
  upper = 1.0_rp
  do iteration = 1, 100
     midpoint = 0.5_rp * (lower + upper)
     trial = base + midpoint * correction
     if (euler_idp_entropy_is_admissible(trial, gamma, entropy_lower, &
          1.0e-12_rp)) then
        lower = midpoint
     else
        upper = midpoint
     end if
  end do

  @assertEqual(lower, limit, tolerance=1.0e-12_rp)
  @assertFalse(density_limited)
  @assertFalse(energy_limited)
  @assertTrue(entropy_limited)
  trial = base + limit * correction
  admissible = euler_idp_entropy_is_admissible(trial, gamma, &
       entropy_lower, 1.0e-12_rp)
  @assertTrue(admissible)
end subroutine test_newton_secant_matches_bisection

@test
subroutine test_internal_energy_floor_limit()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_limit_endpoint, &
       euler_idp_state_is_admissible
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: base(5), target(5), correction(5), trial(5), limit
  logical :: density_limited, energy_limited, entropy_limited, admissible

  base = make_state(1.0_rp, 0.0_rp, 1.0_rp, gamma)
  target = make_state(1.0_rp, 0.0_rp, 0.4_rp, gamma)
  correction = target - base
  call euler_idp_limit_endpoint(base, correction, 0.5_rp, 1.5_rp, &
       -100.0_rp, gamma, 2.0_rp, limit, density_limited, &
       energy_limited, entropy_limited)

  @assertEqual(1.0_rp / 3.0_rp, limit, tolerance=1.0e-12_rp)
  @assertFalse(density_limited)
  @assertTrue(energy_limited)
  @assertTrue(entropy_limited)
  trial = base + limit * correction
  admissible = euler_idp_state_is_admissible(trial, 2.0_rp)
  @assertTrue(admissible)
end subroutine test_internal_energy_floor_limit

@test
subroutine test_endpoint_sweep_matches_bisection()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_entropy_is_admissible, &
       euler_idp_limit_endpoint, euler_idp_specific_entropy
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: base(5), target(5), correction(5), trial(5)
  real(kind=rp) :: limit, lower, upper, midpoint, entropy_lower
  real(kind=rp) :: rho, velocity, pressure
  logical :: density_limited, energy_limited, entropy_limited, admissible
  integer :: case_index, iteration

  do case_index = 1, 200
     rho = 0.5_rp + 0.01_rp * real(mod(case_index, 50), rp)
     velocity = 0.4_rp * sin(0.37_rp * real(case_index, rp))
     pressure = 0.5_rp + 0.01_rp * real(mod(7 * case_index, 70), rp)
     base = make_state(rho, velocity, pressure, gamma)

     rho = 0.25_rp + 0.02_rp * real(mod(11 * case_index, 60), rp)
     velocity = 1.5_rp * sin(0.23_rp * real(case_index, rp))
     pressure = 0.01_rp + 0.005_rp * real(mod(13 * case_index, 50), rp)
     target = make_state(rho, velocity, pressure, gamma)
     correction = target - base
     entropy_lower = euler_idp_specific_entropy(base, gamma) - &
          0.05_rp - 0.01_rp * real(mod(case_index, 25), rp)

     call euler_idp_limit_endpoint(base, correction, 0.1_rp, 1.6_rp, &
          entropy_lower, gamma, 1.0e-12_rp, limit, density_limited, &
          energy_limited, entropy_limited)

     lower = 0.0_rp
     upper = 1.0_rp
     do iteration = 1, 100
        midpoint = 0.5_rp * (lower + upper)
        trial = base + midpoint * correction
        if (euler_idp_entropy_is_admissible(trial, gamma, entropy_lower, &
             1.0e-12_rp)) then
           lower = midpoint
        else
           upper = midpoint
        end if
     end do

     @assertTrue(limit .ge. 0.0_rp .and. limit .le. 1.0_rp)
     @assertEqual(lower, limit, tolerance=1.0e-10_rp)
     trial = base + limit * correction
     admissible = euler_idp_entropy_is_admissible(trial, gamma, &
          entropy_lower, 1.0e-12_rp)
     @assertTrue(admissible)
  end do
end subroutine test_endpoint_sweep_matches_bisection

@test
subroutine test_symmetric_edge_entropy_limit()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_limit_edge
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: left(5), right(5), left_correction(5)
  real(kind=rp) :: right_correction(5), limit
  logical :: density_limited, energy_limited, entropy_limited

  left = make_state(1.0_rp, 0.0_rp, 1.0_rp, gamma)
  right = make_state(1.0_rp, 0.0_rp, 1.0_rp, gamma)
  left_correction = make_state(1.0_rp, 0.0_rp, 0.25_rp, gamma) - left
  right_correction = -left_correction
  call euler_idp_limit_edge(left, right, left_correction, &
       right_correction, 0.5_rp, 1.5_rp, 0.5_rp, 1.5_rp, &
       log(0.5_rp), log(0.5_rp), gamma, 1.0e-12_rp, limit, &
       density_limited, energy_limited, entropy_limited)

  @assertEqual(2.0_rp / 3.0_rp, limit, tolerance=1.0e-12_rp)
  @assertTrue(entropy_limited)
end subroutine test_symmetric_edge_entropy_limit

@test
subroutine test_valid_base_fast_path_matches_checked_limiter()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_limit_edge
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: left(5), right(5), left_correction(5)
  real(kind=rp) :: right_correction(5), checked_limit, fast_limit
  logical :: checked_density, checked_energy, checked_entropy
  logical :: fast_density, fast_energy, fast_entropy

  left = make_state(1.0_rp, 0.2_rp, 1.0_rp, gamma)
  right = make_state(1.1_rp, -0.1_rp, 0.9_rp, gamma)
  left_correction = make_state(1.4_rp, 1.2_rp, 0.05_rp, gamma) - left
  right_correction = -left_correction
  call euler_idp_limit_edge(left, right, left_correction, &
       right_correction, 0.5_rp, 1.5_rp, 0.5_rp, 1.5_rp, &
       log(0.5_rp), log(0.5_rp), gamma, 1.0e-12_rp, checked_limit, &
       checked_density, checked_energy, checked_entropy)
  call euler_idp_limit_edge(left, right, left_correction, &
       right_correction, 0.5_rp, 1.5_rp, 0.5_rp, 1.5_rp, &
       log(0.5_rp), log(0.5_rp), gamma, 1.0e-12_rp, fast_limit, &
       fast_density, fast_energy, fast_entropy, &
       check_base_constraints = .false.)

  @assertEqual(checked_limit, fast_limit, tolerance=1.0e-14_rp)
  @assertEqual(checked_density, fast_density)
  @assertEqual(checked_energy, fast_energy)
  @assertEqual(checked_entropy, fast_entropy)
end subroutine test_valid_base_fast_path_matches_checked_limiter

@test
subroutine test_optional_internal_energy_constraint()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_limit_endpoint
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: base(5), correction(5), limit
  logical :: density_limited, energy_limited, entropy_limited

  base = make_state(1.0_rp, 0.0_rp, 1.0_rp, gamma)
  correction = 0.0_rp
  correction(2) = 3.0_rp
  call euler_idp_limit_endpoint(base, correction, 0.5_rp, 1.5_rp, &
       -100.0_rp, gamma, 1.0e-12_rp, limit, density_limited, &
       energy_limited, entropy_limited, enforce_internal_energy = .false., &
       enforce_entropy = .false.)

  @assertEqual(1.0_rp, limit, tolerance=1.0e-14_rp)
  @assertFalse(energy_limited)
  @assertFalse(entropy_limited)
end subroutine test_optional_internal_energy_constraint

@test
subroutine test_optional_internal_energy_constraint_on_base()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_limit_endpoint
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: base(5), correction(5), limit
  logical :: density_limited, energy_limited, entropy_limited

  base = make_state(1.0_rp, 0.0_rp, 1.0_rp, gamma)
  base(5) = -1.0_rp
  correction = 0.0_rp
  call euler_idp_limit_endpoint(base, correction, 0.5_rp, 1.5_rp, &
       -100.0_rp, gamma, 1.0e-12_rp, limit, density_limited, &
       energy_limited, entropy_limited, enforce_internal_energy = .false., &
       enforce_entropy = .false.)

  @assertEqual(1.0_rp, limit, tolerance=1.0e-14_rp)
  @assertFalse(density_limited)
  @assertFalse(energy_limited)
  @assertFalse(entropy_limited)
end subroutine test_optional_internal_energy_constraint_on_base

@test
subroutine test_optional_entropy_constraint()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_limit_endpoint
  implicit none

  real(kind=rp), parameter :: gamma = 1.4_rp
  real(kind=rp) :: base(5), target(5), correction(5), limit
  logical :: density_limited, energy_limited, entropy_limited

  base = make_state(1.0_rp, 0.0_rp, 1.0_rp, gamma)
  target = make_state(1.0_rp, 0.0_rp, 0.25_rp, gamma)
  correction = target - base
  call euler_idp_limit_endpoint(base, correction, 0.5_rp, 1.5_rp, &
       log(0.5_rp), gamma, 1.0e-12_rp, limit, density_limited, &
       energy_limited, entropy_limited, enforce_internal_energy = .true., &
       enforce_entropy = .false.)

  @assertEqual(1.0_rp, limit, tolerance=1.0e-14_rp)
  @assertFalse(energy_limited)
  @assertFalse(entropy_limited)
end subroutine test_optional_entropy_constraint

@test
subroutine test_floor_timestep_linear_root()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_internal_energy_timestep, &
       euler_idp_state_is_admissible
  implicit none

  real(kind=rp) :: state(5), residual(5), trial(5), limit

  state = [1.0_rp, 0.0_rp, 0.0_rp, 0.0_rp, 2.5_rp]
  residual = [0.0_rp, 0.0_rp, 0.0_rp, 0.0_rp, 3.0_rp]
  limit = euler_idp_internal_energy_timestep(state, residual, 0.5_rp, &
       1.0_rp)
  trial = state - limit * residual

  @assertEqual(2.0_rp / 3.0_rp, limit, tolerance=1.0e-12_rp)
  @assertTrue(euler_idp_state_is_admissible(trial, 0.5_rp))
end subroutine test_floor_timestep_linear_root

@test
subroutine test_floor_timestep_quadratic_root()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_internal_energy_timestep, &
       euler_idp_state_is_admissible
  implicit none

  real(kind=rp) :: state(5), residual(5), trial(5), expected, limit

  state = [1.0_rp, 0.0_rp, 0.0_rp, 0.0_rp, 2.5_rp]
  residual = [0.0_rp, 2.0_rp, 0.0_rp, 0.0_rp, 1.0_rp]
  expected = (sqrt(17.0_rp) - 1.0_rp) / 4.0_rp
  limit = euler_idp_internal_energy_timestep(state, residual, 0.5_rp, &
       1.0_rp)
  trial = state - limit * residual

  @assertEqual(expected, limit, tolerance=1.0e-12_rp)
  @assertTrue(euler_idp_state_is_admissible(trial, 0.5_rp))
end subroutine test_floor_timestep_quadratic_root

@test
subroutine test_floor_timestep_sweep_matches_bisection()
  use pfunit
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_internal_energy_timestep, &
       euler_idp_state_is_admissible
  implicit none

  real(kind=rp) :: state(5), residual(5), trial(5)
  real(kind=rp) :: rho, velocity(3), internal_energy_floor
  real(kind=rp) :: actual, reference, upper_bound
  integer :: case_index
  logical :: admissible

  do case_index = 1, 400
     rho = 0.2_rp + 0.01_rp * real(mod(17 * case_index, 180), rp)
     velocity = [3.0_rp * sin(0.13_rp * real(case_index, rp)), &
          2.0_rp * cos(0.19_rp * real(case_index, rp)), &
          1.5_rp * sin(0.29_rp * real(case_index, rp))]
     internal_energy_floor = 1.0e-4_rp * &
          real(1 + mod(11 * case_index, 40), rp)
     state(1) = rho
     state(2:4) = rho * velocity
     state(5) = internal_energy_floor + 0.05_rp + &
          0.002_rp * real(mod(23 * case_index, 100), rp) + &
          0.5_rp * dot_product(state(2:4), state(2:4)) / rho

     residual(1) = rho * 1.8_rp * sin(0.31_rp * real(case_index, rp))
     residual(2) = rho * 4.0_rp * cos(0.17_rp * real(case_index, rp))
     residual(3) = rho * 3.0_rp * sin(0.37_rp * real(case_index, rp))
     residual(4) = rho * 2.0_rp * cos(0.41_rp * real(case_index, rp))
     residual(5) = state(5) * &
          (0.2_rp + 2.0_rp * abs(sin(0.07_rp * real(case_index, rp))))
     upper_bound = 0.2_rp + &
          0.01_rp * real(mod(29 * case_index, 80), rp)

     actual = euler_idp_internal_energy_timestep(state, residual, &
          internal_energy_floor, upper_bound)
     reference = reference_floor_timestep(state, residual, &
          internal_energy_floor, upper_bound)
     trial = state - actual * residual
     admissible = euler_idp_state_is_admissible(trial, &
          internal_energy_floor)

     @assertTrue(actual .ge. 0.0_rp .and. actual .le. upper_bound)
     @assertEqual(reference, actual, tolerance=1.0e-10_rp)
     @assertTrue(admissible)
  end do
end subroutine test_floor_timestep_sweep_matches_bisection

@test
subroutine test_ssprk_stage_times()
  use pfunit
  use num_types, only : rp
  use euler_idp, only : euler_idp_stage_time
  implicit none

  real(kind=rp), parameter :: time = 2.0_rp
  real(kind=rp), parameter :: dt = 0.2_rp
  real(kind=rp), parameter :: tolerance = 16.0_rp * epsilon(1.0_rp)
  real(kind=rp) :: actual

  actual = euler_idp_stage_time(time, dt, 1, 1)
  @assertEqual(1.8_rp, actual, tolerance=tolerance)
  actual = euler_idp_stage_time(time, dt, 3, 1)
  @assertEqual(1.8_rp, actual, tolerance=tolerance)
  actual = euler_idp_stage_time(time, dt, 3, 2)
  @assertEqual(2.0_rp, actual, tolerance=tolerance)
  actual = euler_idp_stage_time(time, dt, 3, 3)
  @assertEqual(1.9_rp, actual, tolerance=tolerance)
end subroutine test_ssprk_stage_times

@test
subroutine test_stage_cache_invalidation()
  use pfunit
  use euler_idp, only : euler_idp_stage_t
  implicit none

  type(euler_idp_stage_t) :: stage

  @assertFalse(stage%state_valid)
  @assertFalse(stage%boundary_valid)
  @assertFalse(stage%primitive_valid)
  @assertFalse(stage%graph_valid)

  call stage%state_changed()
  @assertEqual(1, stage%state_epoch)
  @assertTrue(stage%state_valid)
  stage%prepared_epoch = stage%state_epoch
  stage%boundary_valid = .true.
  stage%primitive_valid = .true.
  stage%graph_valid = .true.

  call stage%state_changed()
  @assertEqual(2, stage%state_epoch)
  @assertEqual(-1, stage%prepared_epoch)
  @assertTrue(stage%state_valid)
  @assertFalse(stage%boundary_valid)
  @assertFalse(stage%primitive_valid)
  @assertFalse(stage%graph_valid)
end subroutine test_stage_cache_invalidation

pure function make_state(rho, velocity, pressure, gamma) result(state)
  use num_types, only : rp
  real(kind=rp), intent(in) :: rho, velocity, pressure, gamma
  real(kind=rp) :: state(5)

  state = 0.0_rp
  state(1) = rho
  state(2) = rho * velocity
  state(5) = pressure / (gamma - 1.0_rp) + &
       0.5_rp * rho * velocity**2
end function make_state

pure function reference_floor_timestep(state, residual, &
     internal_energy_floor, upper_bound) result(limit)
  use num_types, only : rp
  use euler_idp_backend, only : euler_idp_state_is_admissible
  real(kind=rp), intent(in) :: state(5), residual(5)
  real(kind=rp), intent(in) :: internal_energy_floor, upper_bound
  real(kind=rp) :: limit, lower, upper, midpoint, trial(5)
  integer :: iteration

  upper = max(0.0_rp, upper_bound)
  if (residual(1) .gt. 0.0_rp) then
     upper = min(upper, state(1) / residual(1))
  end if
  trial = state - upper * residual
  if (euler_idp_state_is_admissible(trial, internal_energy_floor)) then
     limit = upper
     return
  end if

  lower = 0.0_rp
  do iteration = 1, 120
     midpoint = 0.5_rp * (lower + upper)
     trial = state - midpoint * residual
     if (euler_idp_state_is_admissible(trial, internal_energy_floor)) then
        lower = midpoint
     else
        upper = midpoint
     end if
  end do
  limit = lower
end function reference_floor_timestep

end module test_euler_idp_limiter
