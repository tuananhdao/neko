module test_euler_gll_graph_parallel
  use mpi
  use pfunit
  use num_types, only : rp
  use point, only : point_t
  use mesh, only : mesh_t
  use space, only : space_t, GLL
  use dofmap, only : dofmap_t
  use gather_scatter, only : gs_t
  use coefs, only : coef_t
  use euler_gll_graph, only : euler_gll_graph_t
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  implicit none

  integer, parameter :: lx_test = 4

  @TestCase
  type, extends(MPITestCase) :: test_euler_gll_graph
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_euler_gll_graph

contains

  subroutine setUp(this)
    class(test_euler_gll_graph), intent(inout) :: this
    call comm_init_test(this%getMpiCommunicator())
  end subroutine setUp

  subroutine tearDown(this)
    class(test_euler_gll_graph), intent(inout) :: this
    call comm_free_test()
  end subroutine tearDown

  !> Constant Cartesian fluxes must remain constant on a warped, straight-
  !! sided element for both the sparse graph and the high-order operator.
  @test(npes=[1])
  subroutine test_warped_hex_free_stream(this)
    class(test_euler_gll_graph), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(euler_gll_graph_t) :: graph
    real(kind=rp) :: flux_x(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: flux_y(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: flux_z(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: low(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: high(lx_test,lx_test,lx_test,1)

    call build_warped_hex_fixture(msh, Xh, dof, gs, coef)
    call graph%init(coef, gs)
    @assertFalse(graph%affine)

    flux_x = 1.25_rp
    flux_y = -0.7_rp
    flux_z = 0.4_rp
    call graph%local_flux_divergence(low, flux_x, flux_y, flux_z)
    call graph%high_order_flux_divergence(high, flux_x, flux_y, flux_z, coef)

    @assertEqual(0.0_rp, maxval(abs(low)), tolerance = 1.0e-12_rp)
    @assertEqual(0.0_rp, maxval(abs(high)), tolerance = 1.0e-12_rp)

    call free_warped_hex_fixture(graph, coef, gs, dof, Xh, msh)
  end subroutine test_warped_hex_free_stream

  !> The reconstructed edge correction must exactly represent the difference
  !! between the sparse and high-order conservative residuals.
  @test(npes=[1])
  subroutine test_warped_hex_correction_identity(this)
    class(test_euler_gll_graph), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(euler_gll_graph_t) :: graph
    real(kind=rp) :: flux_x(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: flux_y(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: flux_z(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: low(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: high(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: correction(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: vector_flux_x(2,lx_test,lx_test,lx_test,1)
    real(kind=rp) :: vector_flux_y(2,lx_test,lx_test,lx_test,1)
    real(kind=rp) :: vector_flux_z(2,lx_test,lx_test,lx_test,1)
    real(kind=rp), allocatable :: edge_flux(:)
    real(kind=rp), allocatable :: vector_edge_flux(:,:)
    real(kind=rp) :: vector_error(2)
    real(kind=rp) :: compatibility_error, correction_error, error_scale
    real(kind=rp) :: vector_correction_error

    call build_warped_hex_fixture(msh, Xh, dof, gs, coef)
    call graph%init(coef, gs)
    @assertFalse(graph%affine)

    flux_x = 1.0_rp + dof%x + dof%x * dof%y + 0.1_rp * dof%z**2
    flux_y = dof%y**2 - 0.3_rp * dof%x * dof%z
    flux_z = dof%z + 0.2_rp * dof%x * dof%y
    call graph%local_flux_divergence(low, flux_x, flux_y, flux_z)
    call graph%high_order_flux_divergence(high, flux_x, flux_y, flux_z, coef)

    allocate(edge_flux(graph%n_edges))
    call graph%directional_correction_flux(edge_flux, flux_x, flux_y, &
         flux_z, coef, compatibility_error)
    call graph%incidence(correction, edge_flux)
    error_scale = max(1.0_rp, maxval(abs(low - high)))
    correction_error = maxval(abs(correction - (low - high)))

    @assertEqual(0.0_rp, compatibility_error, tolerance = 1.0e-12_rp)
    @assertEqual(0.0_rp, correction_error, tolerance = 1.0e-11_rp * error_scale)

    vector_flux_x(1,:,:,:,:) = flux_x
    vector_flux_y(1,:,:,:,:) = flux_y
    vector_flux_z(1,:,:,:,:) = flux_z
    vector_flux_x(2,:,:,:,:) = -0.5_rp * flux_x
    vector_flux_y(2,:,:,:,:) = -0.5_rp * flux_y
    vector_flux_z(2,:,:,:,:) = -0.5_rp * flux_z
    allocate(vector_edge_flux(2, graph%n_edges))
    call graph%directional_correction_flux_vector(vector_edge_flux, &
         vector_flux_x, vector_flux_y, vector_flux_z, coef, vector_error)
    vector_correction_error = max( &
         maxval(abs(vector_edge_flux(1,:) - edge_flux)), &
         maxval(abs(vector_edge_flux(2,:) + 0.5_rp * edge_flux)))
    @assertEqual(0.0_rp, vector_correction_error, tolerance = 1.0e-12_rp * error_scale)

    deallocate(vector_edge_flux)
    deallocate(edge_flux)
    call free_warped_hex_fixture(graph, coef, gs, dof, Xh, msh)
  end subroutine test_warped_hex_correction_identity

  !> On affine elements, a reference-y correction must remain on y-edges.
  @test(npes=[1])
  subroutine test_affine_directional_correction(this)
    class(test_euler_gll_graph), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(euler_gll_graph_t) :: graph
    real(kind=rp) :: flux_x(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: flux_y(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: flux_z(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: low(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: high(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: correction(lx_test,lx_test,lx_test,1)
    real(kind=rp), allocatable :: edge_flux(:)
    real(kind=rp) :: compatibility_error, correction_error, error_scale
    real(kind=rp) :: transverse_flux
    integer :: edge

    call build_affine_hex_fixture(msh, Xh, dof, gs, coef)
    call graph%init(coef, gs)

    flux_x = 0.0_rp
    flux_y = dof%x * dof%y**3
    flux_z = 0.0_rp
    call graph%local_flux_divergence(low, flux_x, flux_y, flux_z)
    call graph%high_order_flux_divergence(high, flux_x, flux_y, flux_z, coef)

    allocate(edge_flux(graph%n_edges))
    call graph%directional_correction_flux(edge_flux, flux_x, flux_y, &
         flux_z, coef, compatibility_error)
    call graph%incidence(correction, edge_flux)

    transverse_flux = 0.0_rp
    do edge = 1, graph%n_edges
       if (graph%direction(edge) .ne. 2) then
          transverse_flux = max(transverse_flux, abs(edge_flux(edge)))
       end if
    end do
    error_scale = max(1.0_rp, maxval(abs(low - high)))
    correction_error = maxval(abs(correction - (low - high)))

    @assertTrue(graph%affine)
    @assertTrue(maxval(abs(edge_flux)) .gt. 1.0e-8_rp)
    @assertEqual(0.0_rp, transverse_flux, tolerance = 1.0e-12_rp)
    @assertEqual(0.0_rp, compatibility_error, tolerance = 1.0e-12_rp)
    @assertEqual(0.0_rp, correction_error, tolerance = 1.0e-11_rp * error_scale)

    deallocate(edge_flux)
    call free_warped_hex_fixture(graph, coef, gs, dof, Xh, msh)
  end subroutine test_affine_directional_correction

  !> A vector graph traversal must match independent scalar reconstructions.
  @test(npes=[1])
  subroutine test_affine_vector_matches_scalar(this)
    class(test_euler_gll_graph), intent(inout) :: this
    integer, parameter :: ncomponents = 5
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(euler_gll_graph_t) :: graph
    real(kind=rp) :: flux_x(ncomponents,lx_test,lx_test,lx_test,1)
    real(kind=rp) :: flux_y(ncomponents,lx_test,lx_test,lx_test,1)
    real(kind=rp) :: flux_z(ncomponents,lx_test,lx_test,lx_test,1)
    real(kind=rp), allocatable :: vector_edge_flux(:,:)
    real(kind=rp), allocatable :: scalar_edge_flux(:,:)
    real(kind=rp) :: vector_error(ncomponents)
    real(kind=rp) :: scalar_error(ncomponents)
    real(kind=rp) :: compatibility_difference, edge_error, error_scale
    integer :: component

    call build_affine_hex_fixture(msh, Xh, dof, gs, coef)
    call graph%init(coef, gs)
    do component = 1, ncomponents
       flux_x(component,:,:,:,:) = real(component, rp) * &
            (1.0_rp + dof%x + dof%y * dof%z)
       flux_y(component,:,:,:,:) = real(component + 1, rp) * &
            (dof%y**2 - 0.2_rp * dof%x * dof%z)
       flux_z(component,:,:,:,:) = real(component + 2, rp) * &
            (dof%z**3 + 0.3_rp * dof%x * dof%y)
    end do

    allocate(vector_edge_flux(ncomponents, graph%n_edges))
    allocate(scalar_edge_flux(ncomponents, graph%n_edges))
    call graph%directional_correction_flux_vector(vector_edge_flux, &
         flux_x, flux_y, flux_z, coef, vector_error)
    do component = 1, ncomponents
       call graph%directional_correction_flux( &
            scalar_edge_flux(component,:), flux_x(component,:,:,:,:), &
            flux_y(component,:,:,:,:), flux_z(component,:,:,:,:), coef, &
            scalar_error(component))
    end do

    error_scale = max(1.0_rp, maxval(abs(scalar_edge_flux)))
    edge_error = maxval(abs(vector_edge_flux - scalar_edge_flux))
    compatibility_difference = maxval(abs(vector_error - scalar_error))
    @assertEqual(0.0_rp, edge_error, tolerance = 1.0e-12_rp * error_scale)
    @assertEqual(0.0_rp, compatibility_difference, tolerance = 1.0e-12_rp)

    deallocate(vector_edge_flux)
    deallocate(scalar_edge_flux)
    call free_warped_hex_fixture(graph, coef, gs, dof, Xh, msh)
  end subroutine test_affine_vector_matches_scalar

  !> Direct incidence assembly must equal the limiter's convex endpoint form.
  @test(npes=[1])
  subroutine test_direct_correction_matches_convex_form(this)
    class(test_euler_gll_graph), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(euler_gll_graph_t) :: graph
    real(kind=rp) :: base(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: direct(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: convex(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: incidence(lx_test,lx_test,lx_test,1)
    real(kind=rp), allocatable :: edge_flux(:)
    real(kind=rp) :: degree, weight, error_scale
    integer :: direction, edge

    call build_affine_hex_fixture(msh, Xh, dof, gs, coef)
    call graph%init(coef, gs)
    allocate(edge_flux(graph%n_edges))
    do edge = 1, graph%n_edges
       edge_flux(edge) = 0.01_rp * sin(real(7 * edge, rp))
    end do
    base = 1.0_rp + 0.1_rp * dof%x - 0.2_rp * dof%y + 0.3_rp * dof%z

    call graph%incidence(incidence, edge_flux)
    direct = base + incidence / graph%mass%x
    convex = 0.0_rp
    do edge = 1, graph%n_edges
       associate(a => graph%left(:,edge), b => graph%right(:,edge))
         direction = graph%direction(edge)
         degree = graph%directional_degree(direction)%x( &
              a(1),a(2),a(3),a(4))
         weight = 1.0_rp / (real(graph%n_directions, rp) * degree)
         convex(a(1),a(2),a(3),a(4)) = convex(a(1),a(2),a(3),a(4)) + &
              weight * (base(a(1),a(2),a(3),a(4)) + edge_flux(edge) / &
              (graph%mass%x(a(1),a(2),a(3),a(4)) * weight))
         degree = graph%directional_degree(direction)%x( &
              b(1),b(2),b(3),b(4))
         weight = 1.0_rp / (real(graph%n_directions, rp) * degree)
         convex(b(1),b(2),b(3),b(4)) = convex(b(1),b(2),b(3),b(4)) + &
              weight * (base(b(1),b(2),b(3),b(4)) - edge_flux(edge) / &
              (graph%mass%x(b(1),b(2),b(3),b(4)) * weight))
       end associate
    end do

    error_scale = max(1.0_rp, maxval(abs(convex)))
    @assertEqual(0.0_rp, maxval(abs(direct - convex)), tolerance = 64.0_rp * epsilon(1.0_rp) * error_scale)

    deallocate(edge_flux)
    call free_warped_hex_fixture(graph, coef, gs, dof, Xh, msh)
  end subroutine test_direct_correction_matches_convex_form

  !> The CPU backend must apply the three SSPRK convex combinations to every
  !! conserved component without altering the saved start-of-step state.
  @test(npes=[1])
  subroutine test_cpu_ssprk_state_composition(this)
    use field, only : field_t
    use euler_idp_backend, only : EULER_IDP_DIAGNOSTICS_OFF
    use euler_idp_cpu, only : euler_idp_cpu_t
    class(test_euler_gll_graph), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(field_t) :: state(5)
    type(euler_idp_cpu_t) :: backend
    real(kind=rp) :: saved(5,lx_test,lx_test,lx_test,1)
    real(kind=rp) :: candidate(5,lx_test,lx_test,lx_test,1)
    real(kind=rp) :: expected(lx_test,lx_test,lx_test,1)
    real(kind=rp) :: tolerance
    character(len=24) :: name
    integer :: component

    call build_affine_hex_fixture(msh, Xh, dof, gs, coef)
    do component = 1, 5
       write(name, '(A,I0)') 'ssprk_state_', component
       call state(component)%init(dof, trim(name))
       saved(component,:,:,:,:) = real(component, rp) + &
            0.1_rp * dof%x - 0.2_rp * dof%y + 0.3_rp * dof%z
       state(component)%x = saved(component,:,:,:,:)
    end do

    call backend%init(dof)
    call backend%init_graph(coef, gs, .false., .false., .true., .true., &
         1.0_rp, 3, EULER_IDP_DIAGNOSTICS_OFF, 1.0e-10_rp)
    call backend%save_state(state(1), state(2), state(3), state(4), &
         state(5))
    tolerance = 128.0_rp * epsilon(1.0_rp)

    do component = 1, 5
       candidate(component,:,:,:,:) = -real(component, rp) + &
            0.4_rp * dof%x + 0.2_rp * dof%y - 0.1_rp * dof%z
       backend%low_candidate(component)%x = candidate(component,:,:,:,:)
    end do
    call backend%combine_stage(state(1), state(2), state(3), state(4), &
         state(5), 0.0_rp, 1.0_rp)
    do component = 1, 5
       @assertEqual(candidate(component,:,:,:,:), state(component)%x, tolerance=tolerance)
    end do

    do component = 1, 5
       candidate(component,:,:,:,:) = 2.0_rp * real(component, rp) - &
            0.3_rp * dof%x + 0.5_rp * dof%y + 0.2_rp * dof%z
       backend%low_candidate(component)%x = candidate(component,:,:,:,:)
    end do
    call backend%combine_stage(state(1), state(2), state(3), state(4), &
         state(5), 0.75_rp, 0.25_rp)
    do component = 1, 5
       expected = 0.75_rp * saved(component,:,:,:,:) + &
            0.25_rp * candidate(component,:,:,:,:)
       @assertEqual(expected, state(component)%x, tolerance=tolerance)
    end do

    do component = 1, 5
       candidate(component,:,:,:,:) = -0.5_rp * real(component, rp) + &
            0.7_rp * dof%x - 0.4_rp * dof%y + 0.6_rp * dof%z
       backend%low_candidate(component)%x = candidate(component,:,:,:,:)
    end do
    call backend%combine_stage(state(1), state(2), state(3), state(4), &
         state(5), 1.0_rp / 3.0_rp, 2.0_rp / 3.0_rp)
    do component = 1, 5
       expected = saved(component,:,:,:,:) / 3.0_rp + &
            2.0_rp * candidate(component,:,:,:,:) / 3.0_rp
       @assertEqual(expected, state(component)%x, tolerance=tolerance)
    end do

    call backend%free()
    do component = 1, 5
       call state(component)%free()
    end do
    call coef%free()
    call gs%free()
    call dof%free()
    call Xh%free()
    call msh%free()
  end subroutine test_cpu_ssprk_state_composition

  !> Build one affine Cartesian hex.
  subroutine build_affine_hex_fixture(msh, Xh, dof, gs, coef)
    type(mesh_t), intent(inout) :: msh
    type(space_t), intent(inout) :: Xh
    type(dofmap_t), intent(inout) :: dof
    type(gs_t), intent(inout) :: gs
    type(coef_t), intent(inout) :: coef
    type(point_t) :: p(8)
    integer :: i

    call p(1)%init(0.0_rp, 0.0_rp, 0.0_rp)
    call p(2)%init(1.0_rp, 0.0_rp, 0.0_rp)
    call p(3)%init(0.0_rp, 1.0_rp, 0.0_rp)
    call p(4)%init(1.0_rp, 1.0_rp, 0.0_rp)
    call p(5)%init(0.0_rp, 0.0_rp, 1.0_rp)
    call p(6)%init(1.0_rp, 0.0_rp, 1.0_rp)
    call p(7)%init(0.0_rp, 1.0_rp, 1.0_rp)
    call p(8)%init(1.0_rp, 1.0_rp, 1.0_rp)
    do i = 1, 8
       call p(i)%set_id(i)
    end do

    call msh%init(3, 1)
    call msh%add_element(1, 1, p(1), p(2), p(3), p(4), &
         p(5), p(6), p(7), p(8))
    call msh%generate_conn()

    call Xh%init(GLL, lx_test, lx_test, lx_test)
    call dof%init(msh, Xh)
    call gs%init(dof)
    call coef%init(gs)
  end subroutine build_affine_hex_fixture

  !> Build one non-parallelepiped trilinear hex with straight edges.
  subroutine build_warped_hex_fixture(msh, Xh, dof, gs, coef)
    type(mesh_t), intent(inout) :: msh
    type(space_t), intent(inout) :: Xh
    type(dofmap_t), intent(inout) :: dof
    type(gs_t), intent(inout) :: gs
    type(coef_t), intent(inout) :: coef
    type(point_t) :: p(8)

    call p(1)%init(0.0_rp, 0.0_rp, 0.0_rp)
    call p(1)%set_id(1)
    call p(2)%init(1.0_rp, 0.0_rp, 0.0_rp)
    call p(2)%set_id(2)
    call p(3)%init(0.02_rp, 1.0_rp, 0.0_rp)
    call p(3)%set_id(3)
    call p(4)%init(1.0_rp, 0.98_rp, 0.0_rp)
    call p(4)%set_id(4)
    call p(5)%init(0.05_rp, 0.02_rp, 1.0_rp)
    call p(5)%set_id(5)
    call p(6)%init(1.05_rp, -0.02_rp, 1.05_rp)
    call p(6)%set_id(6)
    call p(7)%init(-0.03_rp, 0.97_rp, 1.02_rp)
    call p(7)%set_id(7)
    call p(8)%init(0.98_rp, 1.04_rp, 0.98_rp)
    call p(8)%set_id(8)

    call msh%init(3, 1)
    call msh%add_element(1, 1, p(1), p(2), p(3), p(4), &
         p(5), p(6), p(7), p(8))
    call msh%generate_conn()

    call Xh%init(GLL, lx_test, lx_test, lx_test)
    call dof%init(msh, Xh)
    call gs%init(dof)
    call coef%init(gs)
  end subroutine build_warped_hex_fixture

  subroutine free_warped_hex_fixture(graph, coef, gs, dof, Xh, msh)
    type(euler_gll_graph_t), intent(inout) :: graph
    type(coef_t), intent(inout) :: coef
    type(gs_t), intent(inout) :: gs
    type(dofmap_t), intent(inout) :: dof
    type(space_t), intent(inout) :: Xh
    type(mesh_t), intent(inout) :: msh

    call graph%free()
    call coef%free()
    call gs%free()
    call dof%free()
    call Xh%free()
    call msh%free()
  end subroutine free_warped_hex_fixture

end module test_euler_gll_graph_parallel
